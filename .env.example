# 管理员账号
ADMIN_USERNAME=admin

# ⚠️ 必须修改！管理员密码
ADMIN_PASSWORD=your_password_here

# ⚠️ 必须修改！Token 签名密钥（随机字符串）
# 生成方法: openssl rand -hex 32
SECRET_KEY=your_secret_key_here

# 站点标题（页面 <title> 和顶部）
SITE_TITLE=规则文档

# 网站名称（页脚显示）
SITE_NAME=Rules Site

# 版本号
SITE_VERSION=1.0.0

# AI 编码模型（页脚显示，如: GPT-4 / Claude 3）
SITE_AI_MODEL=

# 备案号（页脚显示并链接到工信部）
SITE_ICP=
